{
  "appId": "com.lingdong.script",
  "productName": "灵动脚本-完整版",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*"
  ],
  "extraResources": [
    {
      "from": "python",
      "to": "python",
      "filter": ["**/*"]
    },
    {
      "from": "tools",
      "to": "tools",
      "filter": ["**/*"]
    },
    {
      "from": "templates",
      "to": "templates",
      "filter": ["**/*"]
    },
    {
      "from": "python-runtime",
      "to": "python-runtime",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "target": ["portable"],
    "icon": "assets/icon.png"
  },
  "portable": {
    "artifactName": "${productName}-${version}-portable.${ext}"
  }
}
