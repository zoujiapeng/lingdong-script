        <mxCell id="13" value="&lt;b&gt;LingdongAgent.run()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;接收 goal + mode(旧) / AgentConfig(新)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;持久化 RunSummary → 返回 {success,steps,summary}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6A1B9A;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="160" width="240" height="65" as="geometry" />
