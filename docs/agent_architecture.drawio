        <!-- ═══════════════ SECTION 2: Entry & Config ═══════════════ -->
        <mxCell id="3" value="&lt;b&gt;2. Agent 入口与配置解析&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;统一入口 → AgentConfig 自动解析 → 执行模式分派&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#CE93D8;fontColor=#6A1B9A;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;arcSize=10;" vertex="1" parent="1">
