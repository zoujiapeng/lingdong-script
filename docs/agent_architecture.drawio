        <mxCell id="21" value="&lt;b&gt;🔗 langgraph (函数调用)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;适用: GPT/Claude 等支持函数调用的模型&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;create_react_agent + 全部注册工具 + 监督执行&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;带 sliding_window 历史窗口 + 自动截图验证&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B5E20;fontSize=10;arcSize=8;" vertex="1" parent="1">
