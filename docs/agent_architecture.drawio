        <mxCell id="14" value="&lt;b&gt;AgentConfig.resolve_auto()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;23配置字段 · 自动解析 &quot;auto&quot; 值&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;规则: 多模态模型→text+direct+per_step+minimal&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;     纯文本模型→function_calling+som+pre_plan+full&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6A1B9A;fontSize=10;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="430" y="160" width="280" height="65" as="geometry" />
        </mxCell>
        <mxCell id="15" value="&lt;b&gt;解析关键维度 (4个)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;1. llm_protocol: text / function_calling / computer_use&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;2. planning: per_step / pre_plan (LLM每步/预生成全计划)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;3. vision_mode: text / multimodal / som (纯文本/多模态/标号)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;4. screen_context: minimal(每N步) / full(每步)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#6A1B9A;fontSize=9;arcSize=8;" vertex="1" parent="1">
