        <!-- ═══════════════ SECTION 3: 4 Execution Modes ═══════════════ -->
        <mxCell id="4" value="&lt;b&gt;3. 四种执行模式&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;统一调度入口 _unified_run() 根据 AgentConfig 解析结果自动选择&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#A5D6A7;fontColor=#1B5E20;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;arcSize=10;" vertex="1" parent="1">
