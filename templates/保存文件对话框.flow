      "x": 400,
      "y": 0,
      "params": { "label": "开始" },
      "status": "idle"
    },
    {
      "id": "n_hotkey",
      "type": "keyboard",
      "x": 400,
      "y": 100,
      "params": {
        "keys": ["s"],
        "modifiers": ["ctrl"],
        "delay_after": 2.0
      },
      "status": "idle",
      "label": "Ctrl+S 触发保存"
    },
    {
      "id": "n_save",
      "type": "tool_call",
      "x": 400,
      "y": 220,
      "params": {
        "feature_name": "filedialog_save",
        "params": {
          "path": "",
          "overwrite": true,
          "timeout": 15
        }
      },
      "status": "idle",
      "label": "保存文件对话框"
    },
    {
      "id": "n_end",
      "type": "end",
      "x": 400,
      "y": 340,
      "params": { "label": "结束" },
      "status": "idle"
    }
  ],
  "edges": [
    { "id": "e1", "from_node": "n_start", "from_port": "output", "to_node": "n_hotkey", "to_port": "input" },
    { "id": "e2", "from_node": "n_hotkey", "from_port": "output", "to_node": "n_save", "to_port": "input" },
    { "id": "e3", "from_node": "n_save", "from_port": "output", "to_node": "n_end", "to_port": "input" }
  ],
  "meta": {
    "id": "template-save-dialog",
