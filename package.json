{
  "name": "lingdong-script",
  "version": "1.1.0",
  "description": "Advanced Visual Automation Script Editor",
  "main": "dist/main/main.js",
  "bin": {
    "lingdong": "./dist/cli/cli/index.js"
  },
  "scripts": {
    "predev": "node -e \"try{var cp=require('child_process'),o=cp.execSync('netstat -ano|findstr :5200',{encoding:'utf8',stdio:['pipe','pipe','ignore']}).match(/(\\d+)\\s*$/m);if(o)try{process.kill(+o[1])}catch(e){}}catch(e){}\"",
    "dev": "concurrently --kill-others \"npm run dev:renderer\" \"wait-on http://localhost:5200 && npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "tsc -p tsconfig.main.json && electron .",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.main.json",
    "build:cli": "tsc -p tsconfig.cli.json",
    "build:ai": "tsc -p tsconfig.ai.json",
    "build:all": "npm run build:cli && npm run build:ai",
    "clean": "node scripts/clean-artifacts.cjs",
    "clean:runtime": "node scripts/clean-artifacts.cjs --runtime",
    "eval:list": "python scripts/gui_eval_run.py --list-suites",
    "eval:summary": "python scripts/eval_summary.py",
    "eval:gui:smoke": "python scripts/gui_eval_run.py --suite gui-smoke",
    "eval:gui:manipulation": "python scripts/gui_eval_run.py --suite gui-manipulation",
    "eval:gui:deep": "python scripts/gui_eval_run.py --suite gui-deep-10",
    "cli": "node dist/cli/cli/index.js",
    "ai": "node dist/ai-interface/index.js",
    "ai:mcp": "node dist/ai-interface/index.js --mode mcp",
    "ai:http": "node dist/ai-interface/index.js --mode http",
    "start": "electron ."
  },
  "dependencies": {
    "@rjsf/core": "^6.5.2",
    "@rjsf/validator-ajv8": "^6.5.2",
    "border-beam": "^1.3.0",
    "electron-store": "^8.1.0",
    "immer": "^10.0.0",
    "lucide-react": "^0.400.0",
    "nanoid": "^5.0.0",
    "node-red": "^4.1.10",
    "node-red-contrib-lobster": "file:python/node-red-nodes/lobster",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.0.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^4.1.6",
    "wait-on": "^7.0.0"
  },
  "build": {
    "appId": "com.lingdong.script",
    "productName": "灵动脚本",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "python",
        "to": "python",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.pyo",
          "!**/.pytest_cache/**",
          "!**/traces/**",
          "!**/scripts/**",
          "!**/templates_img/**",
          "!**/experience_memory.json",
          "!**/config.json"
        ]
      },
      {
        "from": "python-runtime",
        "to": "python-runtime",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.pyo",
          "!**/tests/**",
          "!**/test/**",
          "!**/*.dist-info/**",
          "!**/*.egg-info/**",
          "!**/PyWin32.chm"
        ]
      },
      {
        "from": "tools",
        "to": "tools",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "templates",
        "to": "templates",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "electronLanguages": [
        "zh-CN",
        "en-US"
      ],
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
