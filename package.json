{
  "name": "lingdong-script",
  "version": "1.0.0",
  "description": "Advanced Visual Automation Script Editor",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"wait-on http://localhost:5173 && npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "tsc -p tsconfig.main.json && electron .",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.main.json",
    "start": "electron ."
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "immer": "^10.0.0",
    "lucide-react": "^0.400.0",
    "nanoid": "^5.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.0.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "wait-on": "^7.0.0"
  },
  "build": {
    "appId": "com.lingdong.script",
    "productName": "灵动脚本",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/python/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    }
  }
}
